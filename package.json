{
  "name": "tutor-bank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "emu-up": "scripts/emulator.sh up",
    "emu-down": "scripts/emulator.sh down",
    "test:e2e:local": "NODE_OPTIONS=--experimental-vm-modules RUN_E2E=1 DATABASE_URL=postgresql://test:test@127.0.0.1:55432/tutor_bank_test DB_MODE=postgres jest --config jest.e2e.config.js --runInBand",
    "test:e2e:aws": "NODE_OPTIONS=--experimental-vm-modules RUN_E2E=1 DATABASE_URL=postgresql://test:test@127.0.0.1:55432/tutor_bank_test DB_MODE=aws AWS_REGION=us-east-1 AWS_ENDPOINT_URL=http://127.0.0.1:5001 AWS_ACCESS_KEY_ID=dummy AWS_SECRET_ACCESS_KEY=dummy DYNAMODB_TABLE_PREFIX=tutor-bank-test- jest --config jest.e2e.config.js --runInBand",
    "test:parity": "npm test && npm run test:e2e:local && npm run test:e2e:aws"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-dynamodb": "3.1099.0",
    "@aws-sdk/lib-dynamodb": "3.1099.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "typescript": "^5"
  }
}
