{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/guard-exec.sh"
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/sanitise-secrets.sh"
        },
        {
          "type": "command",
          "command": "bash .devin/scripts/inject-context.sh"
        },
        {
          "type": "command",
          "command": "bash .devin/scripts/append-cwd.sh"
        }
      ]
    }
  ]
}
